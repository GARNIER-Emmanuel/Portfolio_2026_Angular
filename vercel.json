{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "preferred_locale",
          "value": "en-US"
        }
      ],
      "destination": "/en-US/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "(?i).*en.*"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "preferred_locale",
          "value": "fr"
        }
      ],
      "destination": "/en-US/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/en-US/(.*)",
      "destination": "/en-US/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/fr/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
