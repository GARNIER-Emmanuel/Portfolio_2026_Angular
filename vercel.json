{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "preferred_locale",
          "value": "en-US"
        }
      ],
      "destination": "/en-US/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "preferred_locale",
          "value": "fr"
        }
      ],
      "destination": "/fr/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "(?i).*en.*"
        }
      ],
      "destination": "/en-US/",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/fr/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/en-US/(.*)",
      "destination": "/en-US/index.html"
    },
    {
      "source": "/fr/(.*)",
      "destination": "/fr/index.html"
    }
  ]
}
